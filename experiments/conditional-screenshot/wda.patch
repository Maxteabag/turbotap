+// Per-response state only. Both benchmark modes take the same fresh capture path.
+@interface FBMeasuredJPEG : NSObject <FBResponsePayload>
+@property (nonatomic, copy) NSData *body;
+@property (nonatomic, copy) NSString *tag;
+@property (nonatomic) double captureMs;
+@property (nonatomic) double hashMs;
+@property (nonatomic) NSUInteger jpegBytes;
+@end
+
+@implementation FBMeasuredJPEG
+- (void)dispatchWithResponse:(RouteResponse *)response
+{
+  [response setHeader:@"Cache-Control" value:@"no-store"];
+  [response setHeader:@"Content-Type" value:self.body.length ? @"image/jpeg" : @"application/octet-stream"];
+  [response setHeader:@"X-Capture-Ms" value:[NSString stringWithFormat:@"%.6f", self.captureMs]];
+  [response setHeader:@"X-Hash-Ms" value:[NSString stringWithFormat:@"%.6f", self.hashMs]];
+  [response setHeader:@"X-JPEG-Bytes" value:@(self.jpegBytes).stringValue];
+  if (self.tag != nil) {
+    [response setHeader:@"ETag" value:self.tag];
+  }
+  [response respondWithData:self.body];
+}
+@end
+
+static NSString *FBJPEGTag(NSData *data)
+{
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(data.bytes, (CC_LONG)data.length, digest);
+  static const char hex[] = "0123456789abcdef";
+  char tag[2 * CC_SHA256_DIGEST_LENGTH + 3];
+  tag[0] = '"';
+  for (NSUInteger i = 0; i < sizeof(digest); ++i) {
+    tag[1 + 2*i] = hex[digest[i] >> 4];
+    tag[2 + 2*i] = hex[digest[i] & 15];
+  }
+  tag[sizeof(tag)-2] = '"';
+  tag[sizeof(tag)-1] = 0;
+  return [NSString stringWithUTF8String:tag];
+}
