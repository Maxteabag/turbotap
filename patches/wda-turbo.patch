+// wda-turbo: single-snapshot on-device UI control walk (zero per-node customActions /
+// accessibility IPC, prunes off-screen cells, skips soft-keyboard keys, compact JSON).
++ (id<FBResponsePayload>)handleFastUI:(FBRouteRequest *)request
+{
+  XCUIApplication *application = XCUIApplication.fb_activeApplication;
+  id<FBXCElementSnapshot> _Nullable snapshot = [application fb_standardSnapshot];
+  if (nil == snapshot) {
+    return FBResponseWithUnknownErrorFormat(@"Cannot get snapshot of the current application");
+  }
+  CGRect rootFrame = snapshot.frame;
+  BOOL rootValid = isfinite(rootFrame.size.width) && isfinite(rootFrame.size.height)
+    && rootFrame.size.width >= 1.0 && rootFrame.size.height >= 1.0;
+  CGFloat screenW = rootValid ? rootFrame.size.width : (CGFloat)0.0;
+  CGFloat screenH = rootValid ? rootFrame.size.height : (CGFloat)0.0;
+#if !TARGET_OS_WATCH
+  if (!rootValid) {
+    CGSize fallbackSize = UIScreen.mainScreen.bounds.size;
+    screenW = fallbackSize.width;
+    screenH = fallbackSize.height;
+  }
+#endif
+  NSInteger sw = (NSInteger)llround(screenW);
+  NSInteger sh = (NSInteger)llround(screenH);
+  NSString *textParam = request.parameters[@"text"];
+  BOOL includeText = (nil != textParam
+                      && ([textParam isEqualToString:@"1"]
+                          || [textParam caseInsensitiveCompare:@"true"] == NSOrderedSame));
+  NSMutableArray<NSDictionary<NSString *, id> *> *items = [NSMutableArray array];
+  FBFastUICollect(snapshot, screenW, screenH, sw, sh, includeText, NO, items);
+  NSString *appName = snapshot.label.length > 0
+    ? snapshot.label
+    : (snapshot.identifier.length > 0 ? snapshot.identifier : @"");
+  NSDictionary<NSString *, id> *payload = @{
+    @"bundleId": application.bundleID ?: @"",
+    @"appName": appName,
+    @"screen": @[@(sw), @(sh)],
+    @"ui": items,
+  };
+  NSError *jsonError = nil;
+  NSData *jsonData = [NSJSONSerialization dataWithJSONObject:payload
+                                                     options:(NSJSONWritingOptions)0
+                                                       error:&jsonError];
+  if (nil == jsonData) {
+    jsonData = [NSJSONSerialization dataWithJSONObject:[payload fb_utf8SafeDictionary]
+                                               options:(NSJSONWritingOptions)0
+                                                 error:&jsonError];
+  }
+  if (nil == jsonData) {
+    return nil != jsonError
+      ? FBResponseWithUnknownError(jsonError)
+      : FBResponseWithUnknownErrorFormat(@"Failed to serialize fastUI response");
+  }
+  return FBResponseWithRawData(jsonData, @"application/json;charset=UTF-8");
+}
+
 @end
