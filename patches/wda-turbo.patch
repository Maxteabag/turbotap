+// wda-turbo: synthesize an event record and wake the current CFRunLoop immediately
+// upon XPC completion, bypassing FBRunLoopSpinner's 100 ms FBWaitInterval sleep.
+static BOOL FBSynthesizeEventFast(XCSynthesizedEventRecord *record, NSError *__autoreleasing *error)
+{
+  __block NSError *innerError = nil;
+  __block atomic_bool done = false;
+  CFRunLoopRef rl = CFRunLoopGetCurrent();
+  CFRetain(rl);
+  [[XCUIDevice.sharedDevice eventSynthesizer] synthesizeEvent:record
+                                                   completion:^(_Bool result, NSError *invokeError) {
+    (void)result;
+    if (nil != invokeError) {
+      innerError = invokeError;
+    }
+    atomic_store_explicit(&done, true, memory_order_release);
+    CFRunLoopStop(rl);
+    CFRunLoopWakeUp(rl);
+    CFRelease(rl);
+  }];
+  while (!atomic_load_explicit(&done, memory_order_acquire)) {
+    CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.02, (Boolean)true);
+  }
+  if (nil != innerError) {
+    if (error) {
+      *error = innerError;
+    }
+    return NO;
+  }
+  return YES;
+}
+
+// wda-turbo: tap screen coordinates (points) with one synthesized touch event.
+// Skips XCUICoordinate's app-quiescence/idle waits that make /wda/tap ~740 ms.
+// Body: {"x": 215, "y": 600, "duration": 0.02 (s, optional)}
++ (id<FBResponsePayload>)handleFastTap:(FBRouteRequest *)request
+{
+  if (nil == request.arguments[@"x"] || nil == request.arguments[@"y"]) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'x' and 'y' are required" traceback:nil]);
+  }
+  CGPoint point = CGPointMake((CGFloat)[request.arguments[@"x"] doubleValue],
+                              (CGFloat)[request.arguments[@"y"] doubleValue]);
+  double duration = nil == request.arguments[@"duration"] ? 0.02 : [request.arguments[@"duration"] doubleValue];
+  XCSynthesizedEventRecord *record = [[XCSynthesizedEventRecord alloc] initWithName:@"wda-turbo fast tap"
+                                                               interfaceOrientation:UIInterfaceOrientationPortrait];
+  XCPointerEventPath *path = [[XCPointerEventPath alloc] initForTouchAtPoint:point offset:0];
+  [path liftUpAtOffset:duration];
+  [record addPointerEventPath:path];
+  NSError *error = nil;
+  if (!FBSynthesizeEventFast(record, &error)) {
+    return FBResponseWithUnknownError(error);
+  }
+  return FBResponseWithOK();
+}
+
+// wda-turbo: one synthesized drag/swipe in points.
+// Body: {"fromX","fromY","toX","toY","duration": move seconds (default 0.12),
+//        "hold": seconds before moving (default 0), "release": seconds at the end before lifting
+//        (default 0.02; ~0.15 stops scroll momentum for a precise scroll)}
++ (id<FBResponsePayload>)handleFastDrag:(FBRouteRequest *)request
+{
+  NSDictionary *a = request.arguments ?: @{};
+  if (nil == a[@"fromX"] || nil == a[@"fromY"] || nil == a[@"toX"] || nil == a[@"toY"]) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'fromX', 'fromY', 'toX' and 'toY' are required" traceback:nil]);
+  }
+  CGPoint from = CGPointMake((CGFloat)[a[@"fromX"] doubleValue], (CGFloat)[a[@"fromY"] doubleValue]);
+  CGPoint to = CGPointMake((CGFloat)[a[@"toX"] doubleValue], (CGFloat)[a[@"toY"] doubleValue]);
+  double duration = nil == a[@"duration"] ? 0.12 : [a[@"duration"] doubleValue];
+  double hold = nil == a[@"hold"] ? 0.0 : [a[@"hold"] doubleValue];
+  double release = nil == a[@"release"] ? 0.02 : [a[@"release"] doubleValue];
+  XCSynthesizedEventRecord *record = [[XCSynthesizedEventRecord alloc] initWithName:@"wda-turbo fast drag"
+                                                               interfaceOrientation:UIInterfaceOrientationPortrait];
+  XCPointerEventPath *path = [[XCPointerEventPath alloc] initForTouchAtPoint:from offset:0];
+  [path moveToPoint:to atOffset:hold + duration];
+  if (release > 0.03) {
+    // A hold with no move samples still flings: UIKit keeps the last velocity.
+    // Crawl 1 pt during the hold so the release velocity is ~0 (no momentum).
+    [path moveToPoint:CGPointMake(to.x, to.y + 1) atOffset:hold + duration + release - 0.01];
+  }
+  [path liftUpAtOffset:hold + duration + release];
+  [record addPointerEventPath:path];
+  NSError *error = nil;
+  if (!FBSynthesizeEventFast(record, &error)) {
+    return FBResponseWithUnknownError(error);
+  }
+  return FBResponseWithOK();
+}
