+// wda-turbo: fastUI type filter (if/else chain avoids -Wswitch-enum under -Weverything).
+static NSString * _Nullable FBFastUIControlTypeName(XCUIElementType type)
+{
+  if (type == XCUIElementTypeButton) return @"Button";
+  if (type == XCUIElementTypeKey) return @"Key";
+  if (type == XCUIElementTypeTab) return @"Tab";
+  if (type == XCUIElementTypeSearchField) return @"SearchField";
+  if (type == XCUIElementTypeTextField) return @"TextField";
+  if (type == XCUIElementTypeSecureTextField) return @"SecureTextField";
+  if (type == XCUIElementTypeTextView) return @"TextView";
+  if (type == XCUIElementTypeCell) return @"Cell";
+  if (type == XCUIElementTypeLink) return @"Link";
+  if (type == XCUIElementTypeSwitch) return @"Switch";
+  if (type == XCUIElementTypeSlider) return @"Slider";
+  if (type == XCUIElementTypeSegmentedControl) return @"SegmentedControl";
+  if (type == XCUIElementTypeImage) return @"Image";
+  return nil;
+}
+
+static void FBFastUICollect(id<FBXCElementSnapshot> _Nullable snapshot,
+                            CGFloat screenW,
+                            CGFloat screenH,
+                            NSInteger sw,
+                            NSInteger sh,
+                            BOOL includeText,
+                            BOOL inKeyboard,
+                            NSMutableArray<NSDictionary<NSString *, id> *> *out)
+{
+  if (nil == snapshot) {
+    return;
+  }
+  XCUIElementType type = snapshot.elementType;
+  CGRect frame = snapshot.frame;
+  BOOL finiteFrame = isfinite(frame.origin.x) && isfinite(frame.origin.y)
+    && isfinite(frame.size.width) && isfinite(frame.size.height);
+  if (type == XCUIElementTypeCell && finiteFrame && frame.size.width > 0.0 && frame.size.height > 0.0) {
+    if (frame.origin.x >= screenW || frame.origin.x + frame.size.width <= 0.0
+        || frame.origin.y >= screenH || frame.origin.y + frame.size.height <= 0.0) {
+      return;
+    }
+  }
+  BOOL kb = inKeyboard || (type == XCUIElementTypeKeyboard);
+  NSString *label = snapshot.label;
+  if (label.length == 0) {
+    NSString *ident = snapshot.identifier;
+    label = ident.length > 0 ? ident : nil;
+  }
+  NSString *typeName = FBFastUIControlTypeName(type);
+  if (nil == typeName) {
+    if (type == XCUIElementTypeStaticText && includeText) {
+      typeName = @"Text";
+    } else if (type == XCUIElementTypeOther && label.length == 0) {
+      id rawVal = snapshot.value;
+      if (nil != rawVal && rawVal != NSNull.null) {
+        NSString *vStr = [NSString stringWithFormat:@"%@", rawVal];
+        if (vStr.length > 0) {
+          label = vStr;
+          typeName = @"Value";
+        }
+      }
+    }
+  }
+  if (nil != typeName && !(type == XCUIElementTypeKey && kb)
+      && label.length > 0
+      && finiteFrame && frame.size.width > 0.0 && frame.size.height > 0.0) {
+    CGFloat cxF = frame.origin.x + frame.size.width * (CGFloat)0.5;
+    if (type == XCUIElementTypeSwitch) {
+      CGFloat halfW = frame.size.width * (CGFloat)0.5;
+      cxF = frame.origin.x + frame.size.width - MIN(halfW, (CGFloat)32.0);
+    }
+    CGFloat cyF = frame.origin.y + frame.size.height * (CGFloat)0.5;
+    NSInteger cx = (NSInteger)cxF;
+    NSInteger cy = (NSInteger)cyF;
+    if (cx > 0 && cx < sw && cy > 0 && cy < sh) {
+      NSString *valStr = nil;
+      if (type == XCUIElementTypeSwitch || type == XCUIElementTypeSlider
+          || type == XCUIElementTypeTextField || type == XCUIElementTypeSearchField) {
+        id rawVal = snapshot.value;
+        if (type == XCUIElementTypeSwitch) {
+          if (nil != rawVal && rawVal != NSNull.null) {
+            if ([rawVal respondsToSelector:@selector(boolValue)]) {
+              valStr = [rawVal boolValue] ? @"1" : @"0";
+            } else {
+              valStr = [NSString stringWithFormat:@"%@", rawVal];
+            }
+          }
+        } else {
+          if (nil != rawVal && rawVal != NSNull.null) {
+            NSString *s = [NSString stringWithFormat:@"%@", rawVal];
+            if (s.length > 0) {
+              valStr = s;
+            }
+          }
+          if (nil == valStr && (type == XCUIElementTypeTextField || type == XCUIElementTypeSearchField)) {
+            NSString *ph = snapshot.placeholderValue;
+            if (nil != ph && ph.length > 0) {
+              valStr = ph;
+            }
+          }
+        }
+      }
+      if (nil != valStr && valStr.length > 0 && ![valStr isEqualToString:label]) {
+        [out addObject:@{
+          @"type": typeName,
+          @"label": label,
+          @"x": @(cx),
+          @"y": @(cy),
+          @"value": valStr,
+        }];
+      } else {
+        [out addObject:@{
+          @"type": typeName,
+          @"label": label,
+          @"x": @(cx),
+          @"y": @(cy),
+        }];
+      }
+    }
+  }
+  NSArray *children = snapshot.children;
+  for (id<FBXCElementSnapshot> child in children) {
+    @autoreleasepool {
+      FBFastUICollect(child, screenW, screenH, sw, sh, includeText, kb, out);
+    }
+  }
+}
