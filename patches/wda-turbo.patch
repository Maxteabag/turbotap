+  double cyVal = (double)screenSize.height * 0.5;
+  if (nil != a[@"x"] || nil != a[@"y"]) {
+    if (!FBExtractFiniteDouble(a[@"x"], &cxVal) || !FBExtractFiniteDouble(a[@"y"], &cyVal)) {
+      return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"Both 'x' and 'y' must be finite numbers when provided" traceback:nil]);
+    }
+  }
+  if (fabs(scale - 1.0) < 0.01) {
+    return FBResponseWithOK();
+  }
