+  double radius = 80.0;
+  if (nil != a[@"radius"]) {
+    if (!FBExtractFiniteDouble(a[@"radius"], &radius)) {
+      return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'radius' must be a finite number" traceback:nil]);
+    }
+  }
+  radius = FBClampDouble(radius, 20.0, maxRadius);
+  double duration = 0.18;
+  if (nil != a[@"duration"]) {
+    if (!FBExtractFiniteDouble(a[@"duration"], &duration)) {
+      return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'duration' must be a finite number" traceback:nil]);
+    }
+  }
