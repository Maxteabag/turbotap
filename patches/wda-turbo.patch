+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'x' and 'y' are required" traceback:nil]);
+  }
+  CGPoint point = CGPointMake((CGFloat)[request.arguments[@"x"] doubleValue],
+                              (CGFloat)[request.arguments[@"y"] doubleValue]);
+  double duration = nil == request.arguments[@"duration"] ? 0.02 : [request.arguments[@"duration"] doubleValue];
+  XCSynthesizedEventRecord *record = [[XCSynthesizedEventRecord alloc] initWithName:@"wda-turbo fast tap"
+                                                               interfaceOrientation:UIInterfaceOrientationPortrait];
+  XCPointerEventPath *path = [[XCPointerEventPath alloc] initForTouchAtPoint:point offset:0];
