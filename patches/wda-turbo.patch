+// wda-turbo: {"x0":0,"y0":460,"x1":430,"y1":700,"quality":0.8,"scale":1.0,"raw":true} (points) ->
+// raw image/jpeg|image/png when "raw":true, or base64 JSON otherwise; scale < 1 downscales on-device.
++ (id<FBResponsePayload>)handleFastScreenshot:(FBRouteRequest *)request
+{
+  NSDictionary *a = request.arguments ?: @{};
+  CGRect rect = CGRectNull;
+  if (nil != a[@"y0"] || nil != a[@"y1"] || nil != a[@"x0"] || nil != a[@"x1"]) {
+    CGSize size = UIScreen.mainScreen.bounds.size;
+    CGFloat x0 = nil == a[@"x0"] ? 0 : (CGFloat)[a[@"x0"] doubleValue];
+    CGFloat y0 = nil == a[@"y0"] ? 0 : (CGFloat)[a[@"y0"] doubleValue];
+    CGFloat x1 = nil == a[@"x1"] ? size.width : (CGFloat)[a[@"x1"] doubleValue];
+    CGFloat y1 = nil == a[@"y1"] ? size.height : (CGFloat)[a[@"y1"] doubleValue];
+    rect = CGRectMake(x0, y0, x1 - x0, y1 - y0);
+  }
+  CGFloat quality = nil == a[@"quality"] ? (CGFloat)0.8 : (CGFloat)[a[@"quality"] doubleValue];
+  UTType *uti = [@"png" isEqualToString:a[@"format"]] ? UTTypePNG : UTTypeJPEG;
+  NSError *error = nil;
+  NSData *data = [FBScreenshot takeWithRect:rect compressionQuality:quality uti:uti error:&error];
+  if (nil == data) {
+    return FBResponseWithStatus([FBCommandStatus unableToCaptureScreenErrorWithMessage:error.description traceback:nil]);
+  }
+  CGFloat scale = nil == a[@"scale"] ? (CGFloat)1.0 : (CGFloat)[a[@"scale"] doubleValue];
+  if (scale > 0.0 && scale < 1.0) {
+    data = FBScaleImageDataFast(data, scale, quality, uti);
+  }
+  id rawArg = a[@"raw"];
+  if ([rawArg respondsToSelector:@selector(boolValue)] && [rawArg boolValue]) {
+    NSString *ct = [uti conformsToType:UTTypePNG] ? @"image/png" : @"image/jpeg";
+    return FBResponseWithRawData(data, ct);
+  }
+  return FBResponseWithObject([data base64EncodedStringWithOptions:(NSDataBase64EncodingOptions)0]);
+}
+
 @end
