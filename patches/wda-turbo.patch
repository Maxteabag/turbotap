+// wda-turbo: sequential multi-tap batch in a single XCSynthesizedEventRecord
+// (one testmanagerd XPC round-trip instead of N) via staggered XCPointerEventPath touches.
+// Body: {"points": [[x1, y1], ...], "interval": 0.09 (s, optional), "duration": 0.02 (s, optional)}
++ (id<FBResponsePayload>)handleFastTapBatch:(FBRouteRequest *)request
+{
+  NSDictionary *a = request.arguments ?: @{};
+  id rawPoints = a[@"points"];
+  if (![rawPoints isKindOfClass:NSArray.class]) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'points' must be a non-empty array of [x, y] pairs" traceback:nil]);
+  }
+  NSArray *points = (NSArray *)rawPoints;
+  if (points.count == 0U || points.count > 64U) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'points' must contain between 1 and 64 points" traceback:nil]);
+  }
+  double duration = 0.02;
+  if (nil != a[@"duration"]) {
+    if (!FBExtractFiniteDouble(a[@"duration"], &duration)) {
+      return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'duration' must be a finite number" traceback:nil]);
+    }
+    duration = FBClampDouble(duration, 0.005, 5.0);
+  }
+  double interval = 0.09;
+  if (nil != a[@"interval"]) {
+    if (!FBExtractFiniteDouble(a[@"interval"], &interval)) {
+      return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'interval' must be a finite number" traceback:nil]);
+    }
+    interval = FBClampDouble(interval, 0.01, 5.0);
+  }
