+typedef NS_ENUM(NSInteger, FBTerminateFastResult) {
+  FBTermSucceeded = 0,
+  FBTermUnavailable = 1,
+  FBTermTimedOut = 2,
+};
+
+// wda-turbo: terminate an application via direct async testmanagerd XPC and wake
+// the current CFRunLoop immediately upon completion, with a bounded timeout so it
+// can never hang. Distinguishes timeout (termination still in flight) from
+// unavailable/rejected XPC so callers never race an unresolved termination.
+static FBTerminateFastResult FBTerminateAppFast(NSString *bundleId, NSTimeInterval timeoutSec)
+{
+  id<XCTMessagingChannel_RunnerToDaemon> daemonProxy = [FBXCTestDaemonsProxy testRunnerProxy];
+  if (![(NSObject *)daemonProxy respondsToSelector:@selector(_XCT_terminateApplicationWithBundleID:completion:)]) {
+    return FBTermUnavailable;
+  }
+  __block NSError *xpcError = nil;
+  __block atomic_bool done = false;
+  __block atomic_bool timedOut = false;
+  __block atomic_bool invoked = false;
+  CFRunLoopRef rl = CFRunLoopGetCurrent();
+  CFRetain(rl);
+  @try {
+    [daemonProxy _XCT_terminateApplicationWithBundleID:bundleId
+                                            completion:^(NSError *invokeError) {
+      if (atomic_exchange_explicit(&invoked, true, memory_order_acq_rel)) {
+        return;
+      }
+      if (nil != invokeError) {
+        xpcError = invokeError;
+      }
+      atomic_store_explicit(&done, true, memory_order_release);
+      if (!atomic_load_explicit(&timedOut, memory_order_acquire)) {
+        CFRunLoopStop(rl);
+        CFRunLoopWakeUp(rl);
+      }
+      CFRelease(rl);
+    }];
+  } @catch (NSException *exception) {
+    (void)exception;
+    if (!atomic_exchange_explicit(&invoked, true, memory_order_acq_rel)) {
+      CFRelease(rl);
+    }
+    return FBTermUnavailable;
+  }
+  NSTimeInterval deadline = NSProcessInfo.processInfo.systemUptime + timeoutSec;
+  while (!atomic_load_explicit(&done, memory_order_acquire)) {
+    NSTimeInterval remaining = deadline - NSProcessInfo.processInfo.systemUptime;
+    if (remaining <= 0.0) {
+      atomic_store_explicit(&timedOut, true, memory_order_release);
+      return FBTermTimedOut;
+    }
+    CFRunLoopRunInMode(kCFRunLoopDefaultMode, MIN(0.02, remaining), (Boolean)true);
+  }
+  return (nil == xpcError) ? FBTermSucceeded : FBTermUnavailable;
+}
 
