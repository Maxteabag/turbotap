+// Finger endpoints are clamped inside screen bounds with an edge margin.
+// Body: {"x": cx (optional), "y": cy (optional), "scale": 2.0, "radius": 80 (pt, optional), "duration": 0.18 (s, optional)}
++ (id<FBResponsePayload>)handleFastPinch:(FBRouteRequest *)request
+{
+  NSDictionary *a = request.arguments ?: @{};
+  double scale = 0.0;
+  if (!FBExtractFiniteDouble(a[@"scale"], &scale) || scale <= 0.0) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'scale' is required and must be a finite number > 0" traceback:nil]);
+  }
+  CGSize screenSize = CGSizeMake((CGFloat)430.0, (CGFloat)932.0);
+#if !TARGET_OS_WATCH
+  CGSize mainSize = UIScreen.mainScreen.bounds.size;
+  if (isfinite((double)mainSize.width) && isfinite((double)mainSize.height)
+      && mainSize.width >= (CGFloat)1.0 && mainSize.height >= (CGFloat)1.0) {
+    screenSize = mainSize;
+  }
+#endif
