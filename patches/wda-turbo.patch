+// wda-turbo: fast app launch / cold-launch in one round-trip.
+// Skips termination when NotRunning, uses direct async testmanagerd XPC termination
+// (falling back to [app terminate]), briefly polls until NotRunning, then launches via
+// LSApplicationWorkspace (falling back to [app activate]).
+// Body: {"bundleId": "com.apple.Preferences", "terminate": true|false}
++ (id<FBResponsePayload>)handleFastLaunch:(FBRouteRequest *)request
+{
+  NSDictionary *a = request.arguments ?: @{};
+  id rawBundleId = a[@"bundleId"];
+  if (![rawBundleId isKindOfClass:NSString.class] || ((NSString *)rawBundleId).length == 0U) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"'bundleId' must be a non-empty string"
+                                                                       traceback:nil]);
+  }
+  NSString *bundleId = (NSString *)rawBundleId;
+  id rawTerminate = a[@"terminate"];
+  BOOL shouldTerminate = (nil != rawTerminate && [rawTerminate respondsToSelector:@selector(boolValue)])
+    ? [rawTerminate boolValue]
+    : NO;
+
+  XCUIApplication *app = [[XCUIApplication alloc] initWithBundleIdentifier:bundleId];
+  BOOL didTerminate = NO;
+  if (shouldTerminate
+      && ![bundleId isEqualToString:@"com.apple.springboard"]
+      && app.state > XCUIApplicationStateNotRunning) {
+    FBTerminateFastResult termResult = FBTerminateAppFast(bundleId, 2.0);
+    if (termResult == FBTermTimedOut) {
+      NSString *msg = [NSString stringWithFormat:@"Timed out waiting for '%@' termination", bundleId];
+      return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:msg traceback:nil]);
+    }
+    if (termResult == FBTermSucceeded) {
+      didTerminate = YES;
+    } else if (app.state > XCUIApplicationStateNotRunning) {
+      @try {
+        [app terminate];
+        didTerminate = YES;
+      } @catch (NSException *exception) {
+        return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:exception.reason ?: @"Failed to terminate application"
+                                                                   traceback:nil]);
+      }
+    } else {
+      didTerminate = YES;
+    }
+    NSTimeInterval pollDeadline = NSProcessInfo.processInfo.systemUptime + 0.8;
+    while (app.state > XCUIApplicationStateNotRunning
+           && NSProcessInfo.processInfo.systemUptime < pollDeadline) {
+      CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.02, (Boolean)true);
+    }
+    if (app.state > XCUIApplicationStateNotRunning) {
+      NSString *msg = [NSString stringWithFormat:@"Application '%@' did not reach NotRunning after termination", bundleId];
+      return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:msg traceback:nil]);
+    }
+  }
+
+  BOOL launched = [FBUnattachedAppLauncher launchAppWithBundleId:bundleId];
+  if (!launched) {
+    @try {
+      [app activate];
+    } @catch (NSException *exception) {
+      NSString *msg = exception.reason ?: [NSString stringWithFormat:@"Failed to launch '%@'", bundleId];
+      return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:msg traceback:nil]);
+    }
+    launched = (app.state > XCUIApplicationStateNotRunning);
+    if (!launched) {
+      NSString *msg = [NSString stringWithFormat:@"Failed to launch application '%@'", bundleId];
+      return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:msg traceback:nil]);
+    }
+  }
+
+  return FBResponseWithObject(@{
+    @"bundleId": bundleId,
+    @"terminated": @(didTerminate),
+    @"launched": @(launched),
+  });
+}
