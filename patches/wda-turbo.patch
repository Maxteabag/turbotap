+                              FBClampCGFloat(cy - endD, margin, maxY));
+  CGPoint p2Start = CGPointMake(FBClampCGFloat(cx + startD, margin, maxX),
+                                FBClampCGFloat(cy + startD, margin, maxY));
+  CGPoint p2End = CGPointMake(FBClampCGFloat(cx + endD, margin, maxX),
+                              FBClampCGFloat(cy + endD, margin, maxY));
