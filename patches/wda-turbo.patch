+// wda-turbo: downscale JPEG/PNG via ImageIO thumbnail subsampling (avoids full RGBA
+// UIGraphicsImageRenderer redraw and per-call FBImageProcessor dispatch queue alloc).
+static NSData *FBScaleImageDataFast(NSData *srcData, CGFloat scale, CGFloat quality, UTType *uti)
+{
+  CGImageSourceRef src = CGImageSourceCreateWithData((__bridge CFDataRef)srcData, NULL);
+  if (NULL == src) {
+    return srcData;
+  }
+  NSDictionary *props = (__bridge_transfer NSDictionary *)CGImageSourceCopyPropertiesAtIndex(src, 0, NULL);
+  double pw = [props[(__bridge NSString *)kCGImagePropertyPixelWidth] doubleValue];
+  double ph = [props[(__bridge NSString *)kCGImagePropertyPixelHeight] doubleValue];
+  double maxDim = MAX(pw, ph) * (double)scale;
+  if (maxDim < 16.0) {
+    CFRelease(src);
+    return srcData;
+  }
+  NSDictionary *thumbOpts = @{
+    (__bridge NSString *)kCGImageSourceCreateThumbnailFromImageAlways: @YES,
+    (__bridge NSString *)kCGImageSourceCreateThumbnailWithTransform: @YES,
+    (__bridge NSString *)kCGImageSourceThumbnailMaxPixelSize: @(llround(maxDim)),
+  };
+  CGImageRef thumb = CGImageSourceCreateThumbnailAtIndex(src, 0, (__bridge CFDictionaryRef)thumbOpts);
+  CFRelease(src);
+  if (NULL == thumb) {
+    return srcData;
+  }
+  NSMutableData *out = [NSMutableData data];
+  CGImageDestinationRef dst = CGImageDestinationCreateWithData((__bridge CFMutableDataRef)out,
+                                                               (__bridge CFStringRef)uti.identifier,
+                                                               1,
+                                                               NULL);
+  if (NULL == dst) {
+    CFRelease(thumb);
+    return srcData;
+  }
+  NSDictionary *encOpts = [uti conformsToType:UTTypePNG]
+    ? nil
+    : @{(__bridge NSString *)kCGImageDestinationLossyCompressionQuality: @(quality)};
+  CGImageDestinationAddImage(dst, thumb, (__bridge CFDictionaryRef)encOpts);
+  BOOL ok = CGImageDestinationFinalize(dst);
+  CFRelease(dst);
+  CFRelease(thumb);
+  return ok ? out : srcData;
+}
 
 @implementation FBScreenshotCommands
 
