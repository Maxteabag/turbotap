+  if (type == XCUIElementTypeTab) return @"Tab";
+  if (type == XCUIElementTypeSearchField) return @"SearchField";
+  if (type == XCUIElementTypeTextField) return @"TextField";
+  if (type == XCUIElementTypeSecureTextField) return @"SecureTextField";
+  if (type == XCUIElementTypeTextView) return @"TextView";
+  if (type == XCUIElementTypeCell) return @"Cell";
+  if (type == XCUIElementTypeLink) return @"Link";
+  if (type == XCUIElementTypeSwitch) return @"Switch";
