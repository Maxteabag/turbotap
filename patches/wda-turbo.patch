+  NSMutableArray<NSValue *> *cgPoints = [NSMutableArray arrayWithCapacity:points.count];
+  for (NSUInteger i = 0U; i < points.count; i++) {
+    id item = points[i];
+    double xVal = 0.0;
+    double yVal = 0.0;
+    BOOL valid = NO;
+    if ([item isKindOfClass:NSArray.class] && ((NSArray *)item).count >= 2U) {
+      NSArray *pair = (NSArray *)item;
+      valid = FBExtractFiniteDouble(pair[0U], &xVal) && FBExtractFiniteDouble(pair[1U], &yVal);
+    } else if ([item isKindOfClass:NSDictionary.class]) {
+      NSDictionary *dict = (NSDictionary *)item;
+      valid = FBExtractFiniteDouble(dict[@"x"], &xVal) && FBExtractFiniteDouble(dict[@"y"], &yVal);
+    }
+    if (!valid) {
+      return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"Each point in 'points' must be [x, y] or {\"x\": x, \"y\": y} with finite numbers" traceback:nil]);
