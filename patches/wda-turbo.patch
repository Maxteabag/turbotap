+// wda-turbo: {"x0":0,"y0":460,"x1":430,"y1":700,"quality":0.8,"scale":1.0} (points) -> base64 JPEG
+// of that band only; scale < 1 downscales on the phone before sending.
++ (id<FBResponsePayload>)handleFastScreenshot:(FBRouteRequest *)request
+{
+  NSDictionary *a = request.arguments ?: @{};
+  CGRect rect = CGRectNull;
+  if (nil != a[@"y0"] || nil != a[@"y1"] || nil != a[@"x0"] || nil != a[@"x1"]) {
+    CGSize size = UIScreen.mainScreen.bounds.size;
+    CGFloat x0 = nil == a[@"x0"] ? 0 : [a[@"x0"] doubleValue];
+    CGFloat y0 = nil == a[@"y0"] ? 0 : [a[@"y0"] doubleValue];
+    CGFloat x1 = nil == a[@"x1"] ? size.width : [a[@"x1"] doubleValue];
+    CGFloat y1 = nil == a[@"y1"] ? size.height : [a[@"y1"] doubleValue];
+    rect = CGRectMake(x0, y0, x1 - x0, y1 - y0);
+  }
+  CGFloat quality = nil == a[@"quality"] ? 0.8 : [a[@"quality"] doubleValue];
+  UTType *uti = [@"png" isEqualToString:a[@"format"]] ? UTTypePNG : UTTypeJPEG;
+  NSError *error;
+  NSData *data = [FBScreenshot takeWithRect:rect compressionQuality:quality uti:uti error:&error];
+  if (nil == data) {
+    return FBResponseWithStatus([FBCommandStatus unableToCaptureScreenErrorWithMessage:error.description traceback:nil]);
+  }
+  CGFloat scale = nil == a[@"scale"] ? 1.0 : [a[@"scale"] doubleValue];
+  if (scale > 0 && scale < 1.0) {
+    NSData *scaled = [[[FBImageProcessor alloc] init] scaledImageWithData:data
+                                                                      uti:uti
+                                                            scalingFactor:scale
+                                                       compressionQuality:quality
+                                                                    error:&error];
+    if (nil != scaled) {
+      data = scaled;
+    }
+  }
+  return FBResponseWithObject([data base64EncodedStringWithOptions:(NSDataBase64EncodingOptions)0]);
+}
+
 @end
