+// Both route names expose the same line-level result. Coordinates are fractions
+// of the oriented screenshot, with an origin at the top left.
++ (id<FBResponsePayload>)handleFastOCR:(FBRouteRequest *)request
+{
+  NSDictionary *args = request.arguments;
+  id mode = args[@"mode"] ?: @"fast";
+  if (![@"fast" isEqual:mode] && ![@"accurate" isEqual:mode]) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"mode must be fast or accurate" traceback:nil]);
+  }
+  for (NSString *key in args) {
+    if (![@"mode" isEqual:key]) {
+      return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"Only mode is supported" traceback:nil]);
+    }
+  }
+
+  @autoreleasepool {
+    NSData *png = XCUIScreen.mainScreen.screenshot.PNGRepresentation;
+    if (png.length == 0) {
+      return FBResponseWithStatus([FBCommandStatus unableToCaptureScreenErrorWithMessage:@"No screenshot available" traceback:nil]);
+    }
+    VNRecognizeTextRequest *ocr = [[VNRecognizeTextRequest alloc] init];
+    BOOL accurate = [@"accurate" isEqual:mode];
+    ocr.recognitionLevel = accurate ? VNRequestTextRecognitionLevelAccurate : VNRequestTextRecognitionLevelFast;
+    ocr.usesLanguageCorrection = accurate;
+    VNImageRequestHandler *handler = [[VNImageRequestHandler alloc] initWithData:png options:@{}];
+    NSError *error = nil;
+    if (![handler performRequests:@[ocr] error:&error]) {
+      return FBResponseWithStatus([FBCommandStatus unknownErrorWithMessage:@"Vision text recognition failed" traceback:nil]);
+    }
+
+    NSMutableArray *lines = [NSMutableArray array];
+    for (VNRecognizedTextObservation *item in ocr.results) {
+      VNRecognizedText *best = [item topCandidates:1].firstObject;
+      if (best.string.length == 0) {
+        continue;
+      }
+      CGRect box = item.boundingBox;
+      [lines addObject:@{
+        @"text": best.string,
+        @"confidence": @(best.confidence),
+        @"x": @(CGRectGetMinX(box)),
+        @"y": @(1.0 - CGRectGetMaxY(box)),
+        @"width": @(CGRectGetWidth(box)),
+        @"height": @(CGRectGetHeight(box)),
+      }];
+    }
+    return FBResponseWithObject(@{@"mode": mode, @"lines": lines});
+  }
+}
+
 @end
